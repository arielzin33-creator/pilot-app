{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "FACTORY_RUN": "1",
    "FACTORY_MAX_STOP_RETRIES": "2",
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "MultiEdit",
      "Bash(./.factory/scripts/gates.sh:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git config:*)",
      "Bash(git remote:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(npx:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm publish:*)",
      "Read(.git/config)",
      "Read(**/.env*)",
      "Edit(.claude/**)",
      "Edit(.factory/**)",
      "Edit(.github/**)",
      "Edit(.mcp.json)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(docs/factory/CHARTER.md)",
      "Edit(docs/factory/CONTRACT.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Read|Grep|Glob|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.factory/hooks/guard.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.factory/hooks/stop-gates.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.factory/hooks/config-change.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.factory/hooks/session-end.sh\"",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.git-credentials",
        "~/.netrc",
        "~/.npmrc"
      ],
      "denyWrite": [
        ".github",
        ".factory",
        ".claude",
        "docs/factory/CHARTER.md",
        "docs/factory/CONTRACT.md",
        ".git",
        ".gitattributes",
        "package.json",
        "tsconfig.json",
        "eslint.config.mjs"
      ]
    },
    "network": {
      "allowedDomains": [],
      "strictAllowlist": true
    }
  }
}
